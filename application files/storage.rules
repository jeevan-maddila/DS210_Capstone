rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Attendee check-in selfies: checkin/{eventId}/{fileName} or events/{eventId}/checkin/{attendeeId}
    // Public write allowed for attendee check-in camera capture with file size constraint (15MB)
    match /checkin/{eventId}/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024;
      allow read: if true;
      allow delete: if request.auth != null;
    }

    match /events/{eventId}/checkin/{attendeeId} {
      allow write: if request.resource.size < 15 * 1024 * 1024;
      allow read: if true;
      allow delete: if request.auth != null;
    }

    // Photographer uploaded event photos: photographers/{eventId}/{fileName} or events/{eventId}/photos/{photoId}
    // Upload size limit 50MB
    match /photographers/{eventId}/{fileName} {
      allow write: if request.resource.size < 50 * 1024 * 1024;
      allow read: if true;
      allow delete: if request.auth != null;
    }

    match /events/{eventId}/photos/{photoId} {
      allow write: if request.resource.size < 50 * 1024 * 1024;
      allow read: if true;
      allow delete: if request.auth != null;
    }

    // Fallback: public read for event galleries, write for authenticated users
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
