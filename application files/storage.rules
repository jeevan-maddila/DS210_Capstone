rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Temporary fail-closed policy. Staff access requires a server-mediated
    // flow (or another authorization source compatible with Storage rules).
    // Public check-in photo uploads remain available, but cannot overwrite an
    // existing object. File size and claimed MIME type are bounded here.
    match /checkin/{eventId}/{fileName} {
      allow create: if request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read, update, delete: if false;
    }

    // Cloud Storage Admin SDK operations run under IAM and bypass these rules.
    // Firebase download-token URLs can still grant bearer access to existing
    // objects and must be separately revoked or removed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
