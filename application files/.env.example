# Public URL used in photographer invitation emails.
APP_BASE_URL=http://localhost:3000

# Resend transactional email configuration.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Lumina Hub <onboarding@resend.dev>"

# Random secret used to create private attendee gallery links. Use at least 32 characters.
# Generate one with: openssl rand -hex 32
GALLERY_TOKEN_SECRET="replace_with_a_random_32_character_secret"

# Firebase project configuration used by the server.
GCP_PROJECT_ID=mids-capstone-ajt
FIRESTORE_DATABASE_ID=ai-studio-a1858ef2-f062-409f-aaff-1218861a9484
STORAGE_BUCKET=mids-capstone-ajt.firebasestorage.app

# Required for local Firebase Admin access. Cloud Run uses its service account.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
